# Секреты не хранятся в репозитории. На сервере — /etc/envo/env с правами 600.
ENVO_DB_DSN=postgresql://envo@localhost/envo

# CRM Яндекс.Афиши
ENVO_AFISHA_LOGIN=
ENVO_AFISHA_PASSWORD=
ENVO_AFISHA_CITY_ID=

# Уведомления
ENVO_TELEGRAM_TOKEN=
ENVO_TELEGRAM_CHAT=

# Почта (Microsoft Graph): регистрация приложения в Entra ID, delegated Mail.Send + Mail.Read,
# включён device code flow. Первичный вход: envoctl mail-login
ENVO_GRAPH_TENANT=
ENVO_GRAPH_CLIENT_ID=
ENVO_MAIL_CACHE=/var/lib/envo/graph_token.json
# ENVO_MAIL_FROM кодом не читается: graph.py шлёт через /me/sendMail, то есть от того
# ящика, под которым выполнен envoctl mail-login. Здесь — только напоминание, какой нужен.
ENVO_MAIL_FROM=support@envo.live

# Внешний сторож (healthchecks.io или аналог): пинг после каждого успешного прогона
ENVO_HEARTBEAT_URL=

# Курс
ENVO_RATE_BUFFER=1.0
