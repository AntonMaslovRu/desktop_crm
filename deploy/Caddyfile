# TLS для API: Caddy сам получает и продлевает сертификат. Нужна A-запись хоста на сервер.
# Хост подставляется bootstrap.sh из ENVO_API_HOST через sed.
{
    # Без явного контакта Caddy отправляет в Let's Encrypt «mailto:default» и получает
    # invalidContact — сертификат не выпускается. Сюда же придут письма об истечении.
    email support@envo.live
}

__ENVO_API_HOST__ {
    reverse_proxy 127.0.0.1:8765
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
