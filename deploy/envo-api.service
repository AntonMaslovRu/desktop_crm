[Unit]
Description=Envo Desk — API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=envo
Group=envo
EnvironmentFile=/etc/envo/env
WorkingDirectory=/opt/envo/app
ExecStart=/opt/envo/venv/bin/uvicorn envo.api.main:app --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/envo

[Install]
WantedBy=multi-user.target
